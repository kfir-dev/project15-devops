{
  "info": {
    "name": "Project15 post-deployment smoke tests",
    "description": "Read-only health and products checks through Ingress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"HTTP 200\", function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "pm.test(\"JSON content type\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});",
          "pm.test(\"JSON object response\", function () {",
          "    pm.expect(pm.response.json()).to.be.an(\"object\");",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "ingressHost",
      "value": "project15.local"
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{ingressHost}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is a non-empty string\", function () {",
              "    pm.expect(pm.response.json().status).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{ingressHost}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is a non-empty string\", function () {",
              "    pm.expect(pm.response.json().status).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Database status is a non-empty string\", function () {",
              "    pm.expect(pm.response.json().database).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Products listing",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{ingressHost}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Products is an array\", function () {",
              "    pm.expect(pm.response.json().products).to.be.an(\"array\");",
              "});",
              "pm.test(\"Count is a non-negative integer\", function () {",
              "    const count = pm.response.json().count;",
              "    pm.expect(Number.isInteger(count) && count >= 0).to.equal(true);",
              "});",
              "pm.test(\"Count matches the returned products\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.count).to.equal(body.products.length);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
