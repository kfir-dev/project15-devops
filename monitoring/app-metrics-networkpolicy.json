{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "project15-allow-prometheus",
    "namespace": "project15"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "project15-app"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "monitoring"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "prometheus"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8000
          }
        ]
      }
    ]
  }
}
