{
  "fullnameOverride": "project15-loki",
  "deploymentMode": "Monolithic",
  "defaults": {
    "automountServiceAccountToken": false
  },
  "loki": {
    "auth_enabled": false,
    "commonConfig": {
      "replication_factor": 1
    },
    "storage": {
      "type": "filesystem"
    },
    "schemaConfig": {
      "configs": [
        {
          "from": "2024-04-01",
          "store": "tsdb",
          "object_store": "filesystem",
          "schema": "v13",
          "index": {
            "prefix": "project15_index_",
            "period": "24h"
          }
        }
      ]
    },
    "limits_config": {
      "retention_period": "48h",
      "ingestion_rate_mb": 2,
      "ingestion_burst_size_mb": 4,
      "max_global_streams_per_user": 1000,
      "max_query_parallelism": 2
    },
    "compactor": {
      "working_directory": "/var/loki/compactor",
      "retention_enabled": true,
      "delete_request_store": "filesystem",
      "retention_delete_worker_count": 2
    },
    "querier": {
      "max_concurrent": 2
    },
    "analytics": {
      "reporting_enabled": false
    },
    "image": {
      "registry": "docker.io",
      "repository": "grafana/loki",
      "tag": "3.7.8",
      "digest": "sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193"
    }
  },
  "singleBinary": {
    "replicas": 1,
    "sidecar": false,
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "700m",
        "memory": "1Gi"
      }
    },
    "persistence": {
      "enabled": true,
      "size": "2Gi",
      "storageClass": "standard",
      "accessModes": [
        "ReadWriteOnce"
      ],
      "enableStatefulSetAutoDeletePVC": false,
      "whenDeleted": "Retain",
      "whenScaled": "Retain"
    }
  },
  "gateway": {
    "enabled": false
  },
  "lokiCanary": {
    "enabled": false
  },
  "test": {
    "enabled": false
  },
  "chunksCache": {
    "enabled": false
  },
  "resultsCache": {
    "enabled": false
  },
  "minio": {
    "enabled": false
  },
  "rollout_operator": {
    "enabled": false
  },
  "backend": {
    "replicas": 0
  },
  "read": {
    "replicas": 0
  },
  "write": {
    "replicas": 0
  },
  "ingester": {
    "replicas": 0
  },
  "querier": {
    "replicas": 0
  },
  "queryFrontend": {
    "replicas": 0
  },
  "queryScheduler": {
    "replicas": 0
  },
  "distributor": {
    "replicas": 0
  },
  "compactor": {
    "replicas": 0
  },
  "indexGateway": {
    "replicas": 0
  },
  "bloomPlanner": {
    "replicas": 0
  },
  "bloomBuilder": {
    "replicas": 0
  },
  "bloomGateway": {
    "replicas": 0
  },
  "sidecar": {
    "rules": {
      "enabled": false
    }
  },
  "rbac": {
    "namespaced": true
  }
}
